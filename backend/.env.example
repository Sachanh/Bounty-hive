# HTTP server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Supabase / Postgres — used as the indexed read store (bounties, submissions,
# categories, search). The chain remains the source of truth for value & state;
# this DB exists for rich metadata, search, and history.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# TON network access — used by the indexer to subscribe to/poll contract events
# and resolve account state. "mainnet" | "testnet"
TON_NETWORK=testnet
TONCENTER_API_KEY=replace-with-toncenter-api-key
TONCENTER_API_URL=https://testnet.toncenter.com/api/v2
TONAPI_KEY=replace-with-tonapi-key
TONAPI_URL=https://testnet.tonapi.io

# Address of the deployed BountyFactory contract — the indexer watches this
# address (and the Bounty instances it deploys) for events.
BOUNTY_FACTORY_ADDRESS=EQC...replace-with-deployed-factory-address

# IPFS pinning provider — pick one (or both, with a fallback strategy).
# Pinata: https://docs.pinata.cloud/
PINATA_JWT=replace-with-pinata-jwt
# web3.storage: https://web3.storage/docs/
WEB3_STORAGE_TOKEN=replace-with-web3-storage-token
IPFS_PROVIDER=pinata

# Omniston — used to source the live TON/USD price that the relay signs into
# an attestation consumed by BountyFactory.verifyPriceAttestation on-chain.
# https://docs.ston.fi/docs/developer-section/omniston
OMNISTON_API_URL=https://omni-ws.ston.fi

# Ed25519 keypair for the price-attestation relay. The PUBLIC key must match
# the `priceOracle` address configured on the deployed BountyFactory.
PRICE_ORACLE_PRIVATE_KEY=replace-with-hex-encoded-ed25519-private-key
PRICE_ORACLE_PUBLIC_KEY=replace-with-hex-encoded-ed25519-public-key
