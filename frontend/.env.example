# Public URL where /tonconnect-manifest.json is served (must be HTTPS in production —
# Telegram Mini Apps and TON Connect both require it).
VITE_TONCONNECT_MANIFEST_URL=https://tonbounty.app/tonconnect-manifest.json

# Base URL of the TONBounty backend API (backend/ workspace).
VITE_API_BASE_URL=http://localhost:4000

# TON network: "mainnet" | "testnet"
VITE_TON_NETWORK=testnet

# Address of the deployed BountyFactory contract.
VITE_BOUNTY_FACTORY_ADDRESS=EQC...replace-with-deployed-factory-address

# Omniston endpoint used for live price quotes and swap routing.
# https://docs.ston.fi/docs/developer-section/omniston
VITE_OMNISTON_API_URL=https://omni-ws.ston.fi

# IPFS gateway used to resolve CIDs returned by the backend (read path).
VITE_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Telegram bot username that hosts this Mini App (used for deep links / share buttons).
VITE_TELEGRAM_BOT_USERNAME=tonbounty_bot
